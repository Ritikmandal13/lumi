// ==============================================================================
// 4. MOTOR CONTROL FUNCTIONS
// ==============================================================================

void stopMotors();

void initMotors() {
  ledcAttach(MOTOR_LEFT_IN1,  PWM_FREQ, PWM_RES);
  ledcAttach(MOTOR_LEFT_IN2,  PWM_FREQ, PWM_RES);
  ledcAttach(MOTOR_RIGHT_IN3, PWM_FREQ, PWM_RES);
  ledcAttach(MOTOR_RIGHT_IN4, PWM_FREQ, PWM_RES);
  stopMotors();
  Serial.println("[Motors] L298N initialized on GPIO 38, 39, 40, 48.");
}

void setLeftMotor(int speed) {
  speed = constrain(speed, -255, 255);
  if (speed > 0) {
    ledcWrite(MOTOR_LEFT_IN1, speed);
    ledcWrite(MOTOR_LEFT_IN2, 0);
  } else if (speed < 0) {
    ledcWrite(MOTOR_LEFT_IN1, 0);
    ledcWrite(MOTOR_LEFT_IN2, abs(speed));
  } else {
    ledcWrite(MOTOR_LEFT_IN1, 0);
    ledcWrite(MOTOR_LEFT_IN2, 0);
  }
}

void setRightMotor(int speed) {
  speed = constrain(speed, -255, 255);
  if (speed > 0) {
    ledcWrite(MOTOR_RIGHT_IN3, speed);
    ledcWrite(MOTOR_RIGHT_IN4, 0);
  } else if (speed < 0) {
    ledcWrite(MOTOR_RIGHT_IN3, 0);
    ledcWrite(MOTOR_RIGHT_IN4, abs(speed));
  } else {
    ledcWrite(MOTOR_RIGHT_IN3, 0);
    ledcWrite(MOTOR_RIGHT_IN4, 0);
  }
}

void stopMotors() {
  ledcWrite(MOTOR_LEFT_IN1, 0);
  ledcWrite(MOTOR_LEFT_IN2, 0);
  ledcWrite(MOTOR_RIGHT_IN3, 0);
  ledcWrite(MOTOR_RIGHT_IN4, 0);
}

/**
 * Differential drive mapping:
 * x: -1.0 (left) to +1.0 (right)
 * y: -1.0 (reverse) to +1.0 (forward)
 */
void applyDifferentialDrive(float x, float y) {
  float left  = y + x;
  float right = y - x;

  // Clamp [-1.0, 1.0]
  left  = constrain(left, -1.0f, 1.0f);
  right = constrain(right, -1.0f, 1.0f);

  int leftPwm  = (int)(left * 255.0f);
  int rightPwm = (int)(right * 255.0f);

  setLeftMotor(leftPwm);
  setRightMotor(rightPwm);
}

// ==============================================================================
// 5. OLED DISPLAY ANIMATIONS & UI
// ==============================================================================

void renderDisplay() {
  if (!oledReady) return;
  uint8_t* buffer = display.getBuffer();
  if (!buffer) return;

  // Render all 8 pages with SH1106 page addressing & +2 column offset
  for (uint8_t page = 0; page < 8; page++) {
    // 1. Set Page and Column addresses
    Wire.beginTransmission(activeOledAddr);
    Wire.write(0x00);         // Command mode
    Wire.write(0xB0 + page);  // Page 0..7
    Wire.write(0x02);         // Lower column address (+2 offset for 132-col SH1106 RAM)
    Wire.write(0x10);         // Higher column address (0)
    Wire.endTransmission();

    // 2. Stream 128 bytes in 32-byte I2C chunks
    for (uint8_t chunk = 0; chunk < 128; chunk += 32) {
      Wire.beginTransmission(activeOledAddr);
      Wire.write(0x40);       // Data mode
      for (uint8_t i = 0; i < 32; i++) {
        Wire.write(buffer[page * 128 + chunk + i]);
      }
      Wire.endTransmission();
    }
  }
}

void initOLED() {
  Serial.println("\n[OLED] Initializing I2C bus on SDA=GPIO 21, SCL=GPIO 47...");

  // 1. Bus recovery: clock out any hung state and enable internal pullups
  pinMode(OLED_SCL_PIN, OUTPUT);
  pinMode(OLED_SDA_PIN, INPUT_PULLUP);
  for (int i = 0; i < 9; i++) {
    digitalWrite(OLED_SCL_PIN, HIGH);
    delayMicroseconds(10);
    digitalWrite(OLED_SCL_PIN, LOW);
    delayMicroseconds(10);
  }
  pinMode(OLED_SCL_PIN, INPUT_PULLUP);
  delay(10);

  Wire.begin(OLED_SDA_PIN, OLED_SCL_PIN, 100000); // 100 kHz clock
  delay(50);

  int devicesFound = 0;
  uint8_t foundAddr = 0;

  Serial.println("[I2C] Scanning bus...");
  for (uint8_t addr = 1; addr < 127; addr++) {
    Wire.beginTransmission(addr);
    byte error = Wire.endTransmission();
    if (error == 0) {
      devicesFound++;
      if (addr == 0x3C || addr == 0x3D) {
        Serial.printf("✨ [I2C] Valid OLED address detected: 0x%02X!\n", addr);
        foundAddr = addr;
      }
    }
  }

  if (foundAddr == 0) {
    if (devicesFound > 0) {
      foundAddr = 0x3C;
    } else {
      Serial.println("⚠️ [OLED] No display found on I2C bus.");
      oledReady = false;
      return;
    }
  }

  activeOledAddr = foundAddr;

  // Initialize Adafruit internal GFX buffer
  display.begin(SSD1306_SWITCHCAPVCC, activeOledAddr);
  oledReady = true;

  // Send SH1106 hardware wake-up and configuration sequence
  static const uint8_t init_cmds[] = {
    0xAE,             // Display OFF
    0x02,             // Lower column address: +2
    0x10,             // Higher column address: 0
    0x40,             // Start line 0
    0x81, 0xCF,       // Contrast control
    0xA0,             // Segment re-map (flipped 180 deg)
    0xC0,             // COM output scan direction (flipped 180 deg)
    0xA6,             // Normal display (non-inverted)
    0xA8, 0x3F,       // Multiplex ratio 1/64
    0xD3, 0x00,       // Display offset 0
    0xD5, 0x80,       // Clock divide ratio
    0xD9, 0xF1,       // Pre-charge period
    0xDA, 0x12,       // COM pins config
    0xDB, 0x40,       // VCOM deselect level
    0x8D, 0x14,       // Charge pump ON
    0xAF              // Display ON
  };

  Wire.beginTransmission(activeOledAddr);
  Wire.write(0x00);
  for (size_t i = 0; i < sizeof(init_cmds); i++) {
    Wire.write(init_cmds[i]);
  }
  Wire.endTransmission();

  // Clear all 8 pages in hardware (instantly wipes power-on static/snow)
  display.clearDisplay();
  renderDisplay();

  Serial.printf("🎉 [OLED] SH1106/SSD1306 Display successfully initialized at 0x%02X!\n", activeOledAddr);

  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(20, 28);
  display.println("LUMI BOOTING...");
  renderDisplay();
}

void showPairingScreen(String code) {
  if (!oledReady) return;
  display.clearDisplay();

  // Header Title
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(34, 4);
  display.println("PAIR LUMI");

  // Divider Line
  display.drawFastHLine(10, 16, 108, SSD1306_WHITE);

  // Big 6-Digit Code (e.g. "482 917")
  display.setTextSize(2);
  display.setCursor(22, 26);
  String formatted = code;
  if (code.length() == 6) {
    formatted = code.substring(0, 3) + " " + code.substring(3);
  }
  display.println(formatted);

  // Bottom prompt
  display.setTextSize(1);
  display.setCursor(14, 52);
  display.println("Enter code in app");

  renderDisplay();
}

void drawEyes(int mood, int lookDir) {
  if (!oledReady) return;
  display.clearDisplay();
  mood = constrain(mood, 0, 6);
  lookDir = constrain(lookDir, 0, 2);
  display.drawBitmap(18, 16, peyes[mood][lookDir][0], 32, 32, SSD1306_WHITE);
  display.drawBitmap(78, 16, peyes[mood][lookDir][1], 32, 32, SSD1306_WHITE);
  renderDisplay();
}

void drawBlink() {
  if (!oledReady) return;
  display.clearDisplay();
  display.drawBitmap(18, 16, eye0, 32, 32, SSD1306_WHITE);
  display.drawBitmap(78, 16, eye0, 32, 32, SSD1306_WHITE);
  renderDisplay();
}

void showHappyEyes() {
  currentMood = 1;
  currentLookDir = 0;
  isBlinking = false;
  drawEyes(currentMood, currentLookDir);
}

void setLumiMood(int mood, int lookDir) {
  currentMood = constrain(mood, 0, 6);
  currentLookDir = constrain(lookDir, 0, 2);
  drawEyes(currentMood, currentLookDir);
}

void updateEyeAnimation(unsigned long now) {
  if (!oledReady || !isPaired) return;

  // 1. Finish blink in progress
  if (isBlinking) {
    if (now - blinkStartTime >= 80) { // 80ms blink duration
      isBlinking = false;
      drawEyes(currentMood, currentLookDir);
      lastBlinkTime = now;
      nextBlinkInterval = random(2500, 5500); // Next blink in 2.5 - 5.5s
    }
    return;
  }

  // 2. Trigger natural periodic blink
  if (now - lastBlinkTime >= nextBlinkInterval) {
    isBlinking = true;
    blinkStartTime = now;
    drawBlink();
    return;
  }

  // 3. Natural subtle glance (only when robot is standing still)
  if (lastDriveCommandTime == 0 && (now - lastGlanceTime >= nextGlanceInterval)) {
    lastGlanceTime = now;
    nextGlanceInterval = random(3500, 7000);
    int r = random(0, 10);
    int newDir = (r < 6) ? 0 : (r < 8 ? 1 : 2); // 60% center, 20% left, 20% right
    if (newDir != currentLookDir) {
      currentLookDir = newDir;
      drawEyes(currentMood, currentLookDir);
    }
  }
}

// ==============================================================================
// 6. CAMERA INITIALIZATION (OV3660)
// ==============================================================================

bool initCamera() {
  camera_config_t config = {};              // Zero-initialize ALL fields (prevents garbage values)
  config.ledc_channel = LEDC_CHANNEL_7;     // Isolated from motor PWM channels (0-3)
  config.ledc_timer   = LEDC_TIMER_3;       // Isolated from motor PWM timers (0-1)
  config.pin_d0       = Y2_GPIO_NUM;
  config.pin_d1       = Y3_GPIO_NUM;
  config.pin_d2       = Y4_GPIO_NUM;
  config.pin_d3       = Y5_GPIO_NUM;
  config.pin_d4       = Y6_GPIO_NUM;
  config.pin_d5       = Y7_GPIO_NUM;
  config.pin_d6       = Y8_GPIO_NUM;
  config.pin_d7       = Y9_GPIO_NUM;
  config.pin_xclk     = XCLK_GPIO_NUM;
  config.pin_pclk     = PCLK_GPIO_NUM;
  config.pin_vsync    = VSYNC_GPIO_NUM;
  config.pin_href     = HREF_GPIO_NUM;
  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn     = PWDN_GPIO_NUM;
  config.pin_reset    = RESET_GPIO_NUM;
  config.xclk_freq_hz = 10000000;           // 10MHz stable clock (80MHz / 8) — prevents DMA overflow
  config.pixel_format = PIXFORMAT_JPEG;

  if (psramFound()) {
    Serial.printf("[Camera] PSRAM found! Total: %d bytes, Free: %d bytes\n", ESP.getPsramSize(), ESP.getFreePsram());
    config.frame_size   = FRAMESIZE_VGA;    // Standard 640x480 resolution
    config.jpeg_quality = 12;               // 10-63 (lower = higher quality)
    config.fb_count     = 2;                // Double buffering in PSRAM
    config.grab_mode    = CAMERA_GRAB_LATEST; // Always grabs latest frame
    config.fb_location  = CAMERA_FB_IN_PSRAM; // Explicitly allocate frame buffers in 8MB PSRAM!
  } else {
    Serial.println("⚠️ [Camera] PSRAM is DISABLED in Arduino IDE!");
    Serial.println("👉 Recommended: Set Tools -> PSRAM -> 'OPI PSRAM' for full VGA resolution.");
    Serial.println("👉 Falling back to QVGA (320x240) in internal DRAM...");
    config.frame_size   = FRAMESIZE_QVGA;   // 320x240 fits in internal SRAM
    config.jpeg_quality = 16;
    config.fb_count     = 1;
    config.grab_mode    = CAMERA_GRAB_LATEST;
    config.fb_location  = CAMERA_FB_IN_DRAM;
  }

  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    Serial.printf("[Camera] Camera init failed with error 0x%x\n", err);
    return false;
  }

  // Official sensor adjustments for OV3660 from CameraWebServer
  sensor_t *s = esp_camera_sensor_get();
  if (s != NULL) {
    s->set_vflip(s, 1);       // Flip orientation
    s->set_hmirror(s, 0);
    s->set_brightness(s, 1);  // Slightly enhance brightness
    s->set_saturation(s, -2); // Natural saturation
    s->set_framesize(s, FRAMESIZE_VGA); // 640x480 for smooth 30fps stream
  }
  Serial.println("[Camera] OV3660 initialized successfully!");
  cameraReady = true;
  return true;
}

// ==============================================================================
// 7. HIGH-SPEED CAMERA & CONTROL WEB SERVER
// ==============================================================================

#define PART_BOUNDARY "123456789000000000000987654321"
static const char* _STREAM_CONTENT_TYPE = "multipart/x-mixed-replace;boundary=" PART_BOUNDARY;
static const char* _STREAM_BOUNDARY = "\r\n--" PART_BOUNDARY "\r\n";
static const char* _STREAM_PART = "Content-Type: image/jpeg\r\nContent-Length: %u\r\n\r\n";

static esp_err_t stream_handler(httpd_req_t *req) {
  camera_fb_t *fb = NULL;
  esp_err_t res = ESP_OK;
  size_t _jpg_buf_len = 0;
  uint8_t *_jpg_buf = NULL;
  char part_buf[128];

  res = httpd_resp_set_type(req, _STREAM_CONTENT_TYPE);
  if (res != ESP_OK) return res;

  httpd_resp_set_hdr(req, "Access-Control-Allow-Origin", "*");
  httpd_resp_set_hdr(req, "X-Framerate", "30");

  streamClientActive = true;
  Serial.println("[Stream] Client connected — streaming started.");

  while (true) {
    fb = esp_camera_fb_get();
    if (!fb) {
      vTaskDelay(pdMS_TO_TICKS(10));
      continue;
    }

    _jpg_buf_len = fb->len;
    _jpg_buf = fb->buf;

    if (res == ESP_OK) {
      res = httpd_resp_send_chunk(req, _STREAM_BOUNDARY, strlen(_STREAM_BOUNDARY));
    }
    if (res == ESP_OK) {
      size_t hlen = snprintf(part_buf, 128, _STREAM_PART, (uint32_t)_jpg_buf_len);
      res = httpd_resp_send_chunk(req, part_buf, hlen);
    }
    if (res == ESP_OK) {
      res = httpd_resp_send_chunk(req, (const char *)_jpg_buf, _jpg_buf_len);
    }

    esp_camera_fb_return(fb);
    if (res != ESP_OK) break;
    vTaskDelay(pdMS_TO_TICKS(15)); // ~30 fps cap
  }

  streamClientActive = false;
  Serial.println("[Stream] Client disconnected — streaming stopped.");
  return res;
}

static esp_err_t capture_handler(httpd_req_t *req) {
  camera_fb_t *fb = esp_camera_fb_get();
  if (!fb) {
    httpd_resp_send_500(req);
    return ESP_FAIL;
  }
  httpd_resp_set_type(req, "image/jpeg");
  httpd_resp_set_hdr(req, "Content-Disposition", "inline; filename=capture.jpg");
  httpd_resp_set_hdr(req, "Access-Control-Allow-Origin", "*");
  esp_err_t res = httpd_resp_send(req, (const char *)fb->buf, fb->len);
  esp_camera_fb_return(fb);
  return res;
}

static esp_err_t drive_handler(httpd_req_t *req) {
  char buf[128];
  if (httpd_req_get_url_query_str(req, buf, sizeof(buf)) == ESP_OK) {
    char param_x[32] = {0};
    char param_y[32] = {0};
    float x = 0.0f, y = 0.0f;

    if (httpd_query_key_value(buf, "x", param_x, sizeof(param_x)) == ESP_OK) {
      x = atof(param_x);
    }
    if (httpd_query_key_value(buf, "y", param_y, sizeof(param_y)) == ESP_OK) {
      y = atof(param_y);
    }

    applyDifferentialDrive(x, y);
    lastDriveCommandTime = millis();

    // Eye direction dynamically follows drive steering & motion
    if (x > 0.25f) {
      currentLookDir = 2; // Look right into turn
    } else if (x < -0.25f) {
      currentLookDir = 1; // Look left into turn
    } else {
      currentLookDir = 0; // Look straight
    }

    if (y > 0.25f) {
      currentMood = 0; // Happy when driving forward
    } else if (y < -0.25f) {
      currentMood = 4; // Alert/Upset expression when reversing
    }
    drawEyes(currentMood, currentLookDir);
  }

  httpd_resp_set_hdr(req, "Access-Control-Allow-Origin", "*");
  httpd_resp_set_type(req, "application/json");
  return httpd_resp_send(req, "{\"status\":\"ok\"}", HTTPD_RESP_USE_STRLEN);
}

static esp_err_t stop_handler(httpd_req_t *req) {
  stopMotors();
  currentLookDir = 0;
  drawEyes(currentMood, currentLookDir);
  httpd_resp_set_hdr(req, "Access-Control-Allow-Origin", "*");
  httpd_resp_set_type(req, "application/json");
  return httpd_resp_send(req, "{\"status\":\"stopped\"}", HTTPD_RESP_USE_STRLEN);
}

static esp_err_t mood_handler(httpd_req_t *req) {
  char buf[64];
  if (httpd_req_get_url_query_str(req, buf, sizeof(buf)) == ESP_OK) {
    char param_m[16] = {0};
    char param_d[16] = {0};
    if (httpd_query_key_value(buf, "mood", param_m, sizeof(param_m)) == ESP_OK) {
      currentMood = constrain(atoi(param_m), 0, 6);
    }
    if (httpd_query_key_value(buf, "dir", param_d, sizeof(param_d)) == ESP_OK) {
      currentLookDir = constrain(atoi(param_d), 0, 2);
    }
    drawEyes(currentMood, currentLookDir);
  }
  httpd_resp_set_hdr(req, "Access-Control-Allow-Origin", "*");
  httpd_resp_set_type(req, "application/json");
  return httpd_resp_send(req, "{\"status\":\"mood_updated\"}", HTTPD_RESP_USE_STRLEN);
}

void startCameraServers() {
  httpd_config_t config = HTTPD_DEFAULT_CONFIG();
  config.max_uri_handlers = 8;

  // 1. Stream Server on Port 81
  httpd_config_t stream_config = config;
  stream_config.server_port = 81;
  stream_config.ctrl_port = 32769;

  httpd_uri_t stream_uri = {
    .uri       = "/stream",
    .method    = HTTP_GET,
    .handler   = stream_handler,
    .user_ctx  = NULL
  };

  if (httpd_start(&stream_httpd, &stream_config) == ESP_OK) {
    httpd_register_uri_handler(stream_httpd, &stream_uri);
    Serial.println("[Web Server] Camera Streamer active on port 81");
  }

  // 2. Control & Snapshot & Stream Server on Port 80
  httpd_uri_t capture_uri = { .uri = "/capture",  .method = HTTP_GET, .handler = capture_handler, .user_ctx = NULL };
  httpd_uri_t drive_uri   = { .uri = "/drive",    .method = HTTP_GET, .handler = drive_handler,   .user_ctx = NULL };
  httpd_uri_t stop_uri    = { .uri = "/stop",     .method = HTTP_GET, .handler = stop_handler,    .user_ctx = NULL };
  httpd_uri_t mood_uri    = { .uri = "/mood",     .method = HTTP_GET, .handler = mood_handler,    .user_ctx = NULL };

  if (httpd_start(&control_httpd, &config) == ESP_OK) {
    httpd_register_uri_handler(control_httpd, &capture_uri);
    httpd_register_uri_handler(control_httpd, &stream_uri); // Also available on port 80!
    httpd_register_uri_handler(control_httpd, &drive_uri);
    httpd_register_uri_handler(control_httpd, &stop_uri);
    httpd_register_uri_handler(control_httpd, &mood_uri);
    Serial.println("[Web Server] Drive control server active on port 80");
  }
}

// ==============================================================================
// 8. CLOUD INTEGRATION (SUPABASE REST)
// ==============================================================================

void callRegisterRobot() {
  if (WiFi.status() != WL_CONNECTED) return;

  WiFiClientSecure client;
  client.setInsecure(); // Skip certificate verification for prototype

  HTTPClient https;
  String url = String(SUPABASE_BASE_URL) + "/functions/v1/register-robot";

  if (https.begin(client, url)) {
    https.addHeader("Content-Type", "application/json");

    String requestBody = "{\"lumi_id\":\"" + String(LUMI_ID) + 
                         "\",\"device_secret\":\"" + String(DEVICE_SECRET) + 
                         "\",\"local_ip\":\"" + WiFi.localIP().toString() + "\"}";

    int httpCode = https.POST(requestBody);

    if (httpCode > 0) {
      String payload = https.getString();
      Serial.printf("[Supabase] Code %d: %s\n", httpCode, payload.c_str());

      StaticJsonDocument<512> doc;
      DeserializationError err = deserializeJson(doc, payload);

      if (!err) {
        const char* status = doc["status"];
        
        if (doc.containsKey("pairing_code") && !doc["pairing_code"].isNull()) {
          currentPairingCode = doc["pairing_code"].as<String>();
          Serial.println("==================================================");
          Serial.println("🎉 LUMI PAIRING CODE: " + currentPairingCode);
          Serial.println("📡 ROBOT IP ADDRESS : " + WiFi.localIP().toString());
          Serial.println("👉 Enter this 6-digit code in the LUMI Mobile App!");
          Serial.println("==================================================");
          showPairingScreen(currentPairingCode);
          isPaired = false;
        } else if (status && strcmp(status, "paired") == 0) {
          if (!isPaired) {
            Serial.println("==================================================");
            Serial.println("🎉 ROBOT IS ALREADY PAIRED TO USER ACCOUNT!");
            Serial.println("📡 ROBOT IP ADDRESS : " + WiFi.localIP().toString());
            Serial.println("👀 Showing LUMI eyes on OLED screen!");
            Serial.println("👉 Open the mobile app and start driving!");
            Serial.println("==================================================");
            showHappyEyes();
            isPaired = true;
          }
        }
      }
    } else {
      Serial.printf("[Supabase] Failed to register: %s\n", https.errorToString(httpCode).c_str());
    }
    https.end();
  }
}

void sendHeartbeat() {
  if (WiFi.status() != WL_CONNECTED || !isPaired) return;

  WiFiClientSecure client;
  client.setInsecure();

  HTTPClient https;
  String url = String(SUPABASE_BASE_URL) + "/functions/v1/robot-heartbeat";

  if (https.begin(client, url)) {
    https.addHeader("Content-Type", "application/json");

    int rssi = WiFi.RSSI();
    int wifiBars = (rssi >= -60) ? 4 : (rssi >= -70) ? 3 : (rssi >= -80) ? 2 : 1;

    String requestBody = "{\"lumi_id\":\"" + String(LUMI_ID) + 
                         "\",\"device_secret\":\"" + String(DEVICE_SECRET) + 
                         "\",\"local_ip\":\"" + WiFi.localIP().toString() + 
                         "\",\"battery_percent\":92,\"wifi_signal\":" + String(wifiBars) + "}";

    int httpCode = https.POST(requestBody);
    https.end();
  }
}

// ==============================================================================
// 9. ARDUINO SETUP & MAIN LOOP
// ==============================================================================

void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("\n--- LUMI ESP32-S3 ROBOT [V2.7 CLOCK & PSRAM FIX] ---");

  // 1. Initialize Peripherals (OLED first, Camera second, Motors third)
  initOLED();
  initCamera();  // Claims LEDC Channel 7 & Timer 3 + 8MB PSRAM buffer
  initMotors();  // Motors claim LEDC channels 0-3 afterwards without clock conflict

  // 2. Connect Wi-Fi
  Serial.printf("[Wi-Fi] Connecting to %s...\n", WIFI_SSID);
  if (oledReady) {
    display.clearDisplay();
    display.setCursor(18, 28);
    display.println("Connecting Wi-Fi");
    renderDisplay();
  }

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  int retries = 0;
  while (WiFi.status() != WL_CONNECTED && retries < 30) {
    delay(500);
    Serial.print(".");
    retries++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.printf("\n[Wi-Fi] Connected! IP: %s\n", WiFi.localIP().toString().c_str());
    
    // 3. Start Camera Streaming & Direct Control Web Servers
    startCameraServers();

    // 4. Register with LUMI Supabase Cloud & display 6-digit code on OLED
    callRegisterRobot();
  } else {
    Serial.println("\n[Wi-Fi] Connection failed. Check SSID/Password.");
    if (oledReady) {
      display.clearDisplay();
      display.setCursor(12, 28);
      display.println("Wi-Fi Failed!");
      renderDisplay();
    }
  }
}

void loop() {
  unsigned long now = millis();

  // Update animated robot eyes (natural blinks & glances)
  updateEyeAnimation(now);

  // Failsafe: auto-stop motors if no drive commands received in 1.5 seconds
  if (lastDriveCommandTime > 0 && (now - lastDriveCommandTime > 1500)) {
    stopMotors();
    lastDriveCommandTime = 0;
    currentLookDir = 0;
    drawEyes(currentMood, currentLookDir);
  }

  // Poll for pairing status every 3 seconds while in setup mode
  if (!isPaired && (now - lastCodePoll > 3000)) {
    lastCodePoll = now;
    callRegisterRobot();
  }

  // Send telemetry heartbeat every 10 seconds once paired
  if (isPaired && (now - lastHeartbeat > 10000)) {
    lastHeartbeat = now;
    sendHeartbeat();
  }

  delay(10);
}
